# Copy to .env.local (already gitignored via .env* — never commit the real file)
# and fill in real values. See README.md's Setup section for context.

# --- Testnet deployment (Sepolia) ---
# Private key of a funded Sepolia wallet. Needs ~0.02 Sepolia ETH for gas
# to deploy Aqua + KeelRouter + KeelSkewHook (against the real, already-
# deployed Sepolia PoolManager — see contracts/script/DeployKeelSkewHook.s.sol).
# Get free Sepolia ETH from a faucet (e.g. sepoliafaucet.com, or your RPC
# provider's own faucet) if needed.
DEPLOYER_PRIVATE_KEY=

# RPC endpoint for Sepolia (chain 11155111). From Alchemy, Infura, or any
# other provider's dashboard — free tier is enough for this.
SEPOLIA_RPC_URL=

# Optional: for `forge script --verify`, to verify the deployed contracts'
# source on Etherscan automatically. From etherscan.io -> your account ->
# API Keys. Safe to leave blank; deployment still works without it, you'd
# just verify manually afterward.
ETHERSCAN_API_KEY=

# --- Subgraph Studio ---
# From thegraph.com/studio -> create a subgraph -> the "Deploy Key" shown
# on its page. Used by `graph deploy --studio` (subgraph/package.json).
THEGRAPH_DEPLOY_KEY=

# From thegraph.com/studio -> your account -> API Keys (a Gateway API
# Key, separate from the deploy key above). Used to query the deployed
# subgraph via Subgraph MCP (subgraph/mcp/mcp.config.json) once it's live.
THEGRAPH_GATEWAY_API_KEY=
